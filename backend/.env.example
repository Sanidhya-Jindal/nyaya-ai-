# Backend environment variables for Nyaya AI
# Copy this file to `.env` in the same folder and fill in real values.

# Groq API key (LLM) - get one at https://console.groq.com/keys
GROQ_API_KEY=

# Tavily Search API key (web retrieval) - get one at https://app.tavily.com/
TAVILY_API_KEY=

# Optional: override the Groq chat model. Defaults to openai/gpt-oss-20b.
# Check https://console.groq.com/docs/models for currently available models,
# since providers retire older ones over time.
# GROQ_MODEL=openai/gpt-oss-20b
